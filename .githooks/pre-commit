#!/bin/sh
# 비공개 강의 자료가 공개 저장소로 나가는 것을 막는다.
#
# .gitignore 는 규칙이라 `git add -f` 한 번이면 뚫린다. 이 훅은 스테이징된 목록을
# 직접 보기 때문에 강제 추가도 잡는다. 커밋은 푸시하면 되돌릴 수 없어서 사고 비용이
# 다른 실수와 다르다.
#
# 설치: git config core.hooksPath .githooks

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

blocked=""

# 1. 비공개 경로
for path in $staged; do
  case "$path" in
    # 맨 이름도 막는다. course 는 형제 비공개 저장소를 가리키는 연결이라 `git add -f course`
    # 로 gitlink 하나가 스테이징될 수 있다. 교안 바이트는 안 새지만 비공개 저장소의 HEAD 와
    # 그 경로의 존재가 공개 이력에 남는다.
    course|private|memory|course/*|*/course/*|private/*|*/private/*|memory/*|*/memory/*)
      blocked="$blocked\n  경로: $path"
      ;;
  esac
done

# 2. 비공개 표식이 들어간 파일. 경로를 옮겨도 표식은 따라온다.
for path in $staged; do
  [ -f "$path" ] || continue
  # 규칙을 설명하는 문서는 표식 문자열을 담을 수밖에 없다.
  case "$path" in
    .githooks/pre-commit) continue ;;
    skills/specs/operation/coursePrivate.md) continue ;;
    site/scripts/check-leak.mjs) continue ;;
    CLAUDE.md) continue ;;
  esac
  if grep -qE '^(private|paid|courseOnly): *true|<!-- *eddm:private *-->' "$path" 2>/dev/null; then
    blocked="$blocked\n  표식: $path"
  fi
done

# 3. 자격증명 모양
for path in $staged; do
  [ -f "$path" ] || continue
  if grep -qE 'hf_[A-Za-z0-9]{30,}|CLOUDFLARE_API_TOKEN *= *[A-Za-z0-9_-]{20,}' "$path" 2>/dev/null; then
    blocked="$blocked\n  자격증명 의심: $path"
  fi
done

if [ -n "$blocked" ]; then
  printf '\n비공개 자료가 커밋에 들어 있어 막았습니다.\n'
  printf '%b\n' "$blocked"
  printf '\n강의 자료는 이 공개 저장소에 두지 않습니다. course/ 아래에 두거나 별도 비공개\n'
  printf '저장소로 옮깁니다. 공개해도 되는 파일이라면 비공개 표식을 지우고 다시 커밋합니다.\n\n'
  exit 1
fi

exit 0
