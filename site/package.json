{
  "name": "eddmpython-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:blog": "node scripts/check-blog.mjs",
    "test:blog-style": "node scripts/test-blog-style.mjs",
    "test:blog-package": "node scripts/test-blog-package.mjs",
    "test:blog-env": "python -X utf8 ../blog/scripts/test_project_env.py",
    "test:hash-navigation": "node --experimental-strip-types scripts/test-hash-navigation.ts",
    "test:visual-plan": "node scripts/test-visual-capture-plan.mjs",
    "test:classroom-render": "node --experimental-strip-types scripts/test-classroom-render.ts",
    "check:skills": "node scripts/check-skills.mjs",
    "verify:media": "python -X utf8 ../blog/scripts/publish_media.py --verify",
    "verify:seo": "node scripts/check-seo.mjs",
    "verify:visual": "node scripts/visual.mjs capture",
    "approve:visual": "node scripts/visual.mjs approve",
    "check:visual": "node scripts/visual.mjs check",
    "build": "npm run test && vite build && npm run verify:seo",
    "og": "node --experimental-strip-types scripts/og.mjs",
    "preview": "vite preview",
    "test": "npm run test:blog-style && npm run test:blog-package && npm run test:blog-env && npm run test:hash-navigation && npm run test:visual-plan && npm run test:classroom-render && npm run check:blog && npm run check:skills && tsc --noEmit",
    "deploy": "npm run build && npm run check:leak && npm run check:visual && wrangler deploy",
    "check:post": "node scripts/check-blog.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "cr": "node scripts/classroom-admin.mjs --open",
    "cr:dev": "wrangler dev --port 8787 --persist-to ../../eddmpython.out/wrangler-state",
    "postcr:dev": "node scripts/clean-wrangler.mjs",
    "cr:clean": "node scripts/clean-wrangler.mjs",
    "cr:shot": "node scripts/classroom-shot.mjs"
  },
  "dependencies": {
    "pyproc": "0.0.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.120.0"
  }
}
