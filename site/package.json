{
  "name": "eddmpython-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:blog": "node scripts/check-blog.mjs",
    "test:blog-media": "node scripts/test-blog-media-package.mjs",
    "test:blog-env": "python -X utf8 ../blog/scripts/test_project_env.py",
    "test:hash-navigation": "node --experimental-strip-types scripts/test-hash-navigation.ts",
    "test:visual-plan": "node scripts/test-visual-capture-plan.mjs",
    "test:classroom-render": "node --experimental-strip-types scripts/test-classroom-render.ts",
    "type:classroom-worker": "wrangler types --include-runtime false --config wrangler.classroom.jsonc classroomWorkerEnv.d.ts",
    "check:classroom-worker": "wrangler types --check --include-runtime false --config wrangler.classroom.jsonc classroomWorkerEnv.d.ts && wrangler deploy --dry-run --config wrangler.classroom.jsonc",
    "test:classroom-worker": "node scripts/testClassroomWorker.mjs",
    "test:qr": "node --experimental-strip-types ../blog/posts/003-python-qr/tool/test.ts",
    "check:skills": "node scripts/check-skills.mjs",
    "verify:media": "python -X utf8 ../blog/scripts/publish_media.py --verify",
    "verify:seo": "node scripts/check-seo.mjs",
    "verify:visual": "node scripts/visual.mjs capture",
    "approve:visual": "node scripts/visual.mjs approve",
    "check:visual": "node scripts/visual.mjs check",
    "build": "npm run test && vite build && npm run verify:seo",
    "og": "node --experimental-strip-types scripts/og.mjs",
    "preview": "vite preview",
    "test": "npm run test:blog-media && npm run test:blog-env && npm run test:media-safety && npm run test:workspace-gate && npm run test:hash-navigation && npm run test:visual-plan && npm run test:classroom-render && npm run test:classroom-worker && npm run check:classroom-worker && npm run test:qr && npm run check:blog && npm run check:lint && npm run check:hooks && npm run check:design && npm run check:secrets && npm run check:skills && npm run check:workspace && tsc --noEmit",
    "deploy": "npm run build && npm run check:leak && npm run check:approved && npm run check:visual && wrangler deploy",
    "deploy:classroom": "npm run test:classroom-render && npm run test:classroom-worker && npm run check:design && npm run check:secrets && npm run check:classroom-worker && tsc --noEmit && wrangler deploy --config wrangler.classroom.jsonc",
    "check:post": "node scripts/check-blog.mjs",
    "check:hooks": "node ../hooks/tests/checkBlogWritingGate.mjs && node scripts/test-blog-review.mjs && node scripts/test-blog-lint.mjs",
    "approve:blog": "node scripts/approve-blog.mjs",
    "check:approved": "node scripts/check-blog-approved.mjs",
    "track": "node scripts/track.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "classroom:dev": "wrangler dev --port 8787 --persist-to ../../eddmpython.out/wrangler-state",
    "postclassroom:dev": "node scripts/clean-wrangler.mjs",
    "classroom:clean": "node scripts/clean-wrangler.mjs",
    "classroom:shot": "node scripts/classroom-shot.mjs",
    "classroom:audit": "node scripts/classroom-audit.mjs",
    "admin:shot": "node scripts/admin-shot.mjs",
    "blog:shot": "node scripts/blog-shot.mjs",
    "check:design": "node --experimental-strip-types scripts/check-brand.mjs",
    "check:brand": "npm run check:design",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "test:media-safety": "python -X utf8 ../blog/scripts/test_media_safety.py",
    "test:workspace-gate": "node scripts/test-workspace-gate.mjs",
    "check:lint": "node scripts/check-blog-lint.mjs"
  },
  "dependencies": {
    "pyproc": "0.0.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "hanlint": "0.0.8",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.120.0"
  }
}
