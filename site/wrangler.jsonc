{
  // eddmpython 브랜드 랜딩. 정적 자산 + SPA 라우트 처리 Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eddmpython-site",
  "main": "worker.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "routes": [
    { "pattern": "eddmpython.com", "custom_domain": true },
    { "pattern": "www.eddmpython.com", "custom_domain": true }
  ],
  "assets": {
    // 빌드 산출물은 저장소 밖에 있다 (vite.config.ts 와 동일 경로).
    // 자산이 없으면 worker.ts 가 받아서 /blog 계열만 index.html 로 되돌린다.
    "directory": "../../eddmpython.out/site-dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // /blog 를 /blog/ 로 튕기지 않고 그대로 200 으로 낸다.
    "html_handling": "drop-trailing-slash",
    // 보안 헤더를 모든 응답에 붙이려면 Worker 가 먼저 돌아야 한다.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
