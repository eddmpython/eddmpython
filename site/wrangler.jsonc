{
  // eddmpython 브랜드 랜딩. 정적 자산 전용 Worker (xlpod 배포 패턴 참고).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eddmpython-site",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "routes": [
    { "pattern": "eddmpython.com", "custom_domain": true },
    { "pattern": "www.eddmpython.com", "custom_domain": true }
  ],
  "assets": {
    // 빌드 산출물은 저장소 밖에 있다 (vite.config.ts 와 동일 경로).
    // 단일 페이지 정적 랜딩. router 가 없으므로 없는 경로는 404 를 낸다.
    "directory": "../../eddmpython.out/site-dist",
    "not_found_handling": "none"
  }
}
